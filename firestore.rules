rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validListing(d) {
      return d.keys().hasOnly(['type','title','description','category','condition','price','images','titleKeywords','ownerId','ownerName','campusId','status','createdAt'])
        && d.type in ['sell','exchange']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 1000
        && d.category in ['Books','Electronics','Furniture','Clothing','Stationery','Sports','Other']
        && d.condition in ['new','like-new','good','fair']
        && d.price is number && d.price >= 0 && d.price <= 10000000
        && d.images is list && d.images.size() <= 3
        && (d.images.size() < 1 || (d.images[0] is string && d.images[0].matches('https://res\\.cloudinary\\.com/.*')))
        && (d.images.size() < 2 || (d.images[1] is string && d.images[1].matches('https://res\\.cloudinary\\.com/.*')))
        && (d.images.size() < 3 || (d.images[2] is string && d.images[2].matches('https://res\\.cloudinary\\.com/.*')))
        && d.titleKeywords is list && d.titleKeywords.size() <= 10
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.campusId == 'cu';
    }

    function districts() { return ["Bagerhat", "Bandarban", "Barguna", "Barishal", "Bhola", "Bogura", "Brahmanbaria", "Chandpur", "Chapainawabganj", "Chattogram", "Chuadanga", "Cumilla", "Cox's Bazar", "Dhaka", "Dinajpur", "Faridpur", "Feni", "Gaibandha", "Gazipur", "Gopalganj", "Habiganj", "Jamalpur", "Jashore", "Jhalokati", "Jhenaidah", "Joypurhat", "Khagrachhari", "Khulna", "Kishoreganj", "Kurigram", "Kushtia", "Lakshmipur", "Lalmonirhat", "Madaripur", "Magura", "Manikganj", "Meherpur", "Moulvibazar", "Munshiganj", "Mymensingh", "Naogaon", "Narail", "Narayanganj", "Narsingdi", "Natore", "Netrokona", "Nilphamari", "Noakhali", "Pabna", "Panchagarh", "Patuakhali", "Pirojpur", "Rajbari", "Rajshahi", "Rangamati", "Rangpur", "Satkhira", "Shariatpur", "Sherpur", "Sirajganj", "Sunamganj", "Sylhet", "Tangail", "Thakurgaon"]; }

    function validPublic(d) {
      return d.keys().hasOnly(['displayName','photo','bio','department','session','hometown','verified'])
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 80
        && (!('photo' in d) || d.photo == '' || (d.photo is string && d.photo.size() <= 300 && d.photo.matches('https://res\\.cloudinary\\.com/.*')))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 160))
        && (!('department' in d) || (d.department is string && d.department.size() <= 80))
        && (!('session' in d) || (d.session is string && d.session.size() <= 20))
        && (!('hometown' in d) || d.hometown == '' || d.hometown in districts())
        && (!('verified' in d) || d.verified is bool);
    }

    function isVerifiedUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified';
    }

    // Admins are added by hand in the Firebase console. Clients can never write here.
    match /admins/{uid} {
      // Signed-in users can see who is an admin (for the Admin badge). Nobody can write from the site.
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','email','campusId','role','verificationStatus','createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.campusId == 'cu'
        && request.resource.data.role == 'student'
        && request.resource.data.verificationStatus == 'unverified'
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && (
        // student edits own profile text
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 80
          && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160)))
        ||
        // verification status changes
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus'])
          && (
            (request.auth.uid == uid
              && resource.data.verificationStatus in ['unverified','rejected']
              && request.resource.data.verificationStatus == 'pending')
            ||
            (isAdmin() && request.resource.data.verificationStatus in ['verified','rejected'])
          ))
      );

      allow delete: if false;
    }

    match /studentProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create, update: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus in ['unverified','rejected']
        && request.resource.data.keys().hasOnly(['studentId','department','universityEmail','submittedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() >= 6 && request.resource.data.studentId.size() <= 20
        && request.resource.data.department is string
        && request.resource.data.department.size() >= 2 && request.resource.data.department.size() <= 80
        && request.resource.data.universityEmail is string
        && request.resource.data.universityEmail.size() <= 120
        && request.resource.data.submittedAt == request.time;

      allow delete: if false;
    }

    match /listings/{id} {
      // Public can read active listings; owners and admins can read their own / all.
      allow read: if resource.data.status == 'active'
        || (signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified'
        && validListing(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;

      // Owner may only toggle active/sold (not undo an admin hide). Admin may set any status.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.ownerId == request.auth.uid
            && resource.data.status in ['active','sold']
            && request.resource.data.status in ['active','sold'])
          || (isAdmin() && request.resource.data.status in ['active','sold','hidden'])
        );

      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validPublic(request.resource.data) && (
        // owner: can only claim "verified" if the account really is verified
        (request.auth.uid == uid
          && (!('verified' in request.resource.data)
              || request.resource.data.verified == (get(/databases/$(database)/documents/users/$(uid)).data.verificationStatus == 'verified')))
        || isAdmin()
      );
      allow delete: if false;
    }

    // Addresses: private to the owner and admins unless the owner sets visible = true.
    match /addresses/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || resource.data.visible == true);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['permanent','present','visible'])
        && request.resource.data.permanent is string && request.resource.data.permanent.size() <= 200
        && request.resource.data.present is string && request.resource.data.present.size() <= 200
        && request.resource.data.visible is bool;
      allow delete: if false;
    }

    // Student ID shown to verified students only. Value must match the admin-reviewed submission.
    match /studentIds/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isVerifiedUser());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['studentId'])
        && request.resource.data.studentId is string && request.resource.data.studentId.size() <= 20
        && (
          (request.auth.uid == uid
            && request.resource.data.studentId == get(/databases/$(database)/documents/studentProfiles/$(uid)).data.studentId)
          || isAdmin()
        );
      allow delete: if false;
    }

    // Ratings (1 to 5 stars). One rating per pair of people. Admins cannot be rated.
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['reviewerId','reviewerName','targetId','as','rating','text','createdAt'])
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.targetId
        && !exists(/databases/$(database)/documents/admins/$(request.resource.data.targetId))
        && request.resource.data.as in ['seller','buyer']
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.reviewerName is string && request.resource.data.reviewerName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.reviewerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','text','as'])
        && request.resource.data.as in ['seller','buyer']
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow delete: if signedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // Everything else stays closed until its phase is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
